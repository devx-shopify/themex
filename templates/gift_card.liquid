{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'tailwind.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    <title>{{ 'gift_card.card' | t }} - {{ shop.name }}</title>
  </head>

  <body class="flex min-h-screen items-center justify-center bg-muted/5 p-4">
    <div class="w-full max-w-md rounded-lg bg-background p-8 text-center shadow-lg">
      <h1 class="mb-2 text-2xl font-bold">{{ shop.name }}</h1>
      <p class="mb-6 text-muted">{{ 'gift_card.card' | t }}</p>

      <div class="mb-6">
        {%- if gift_card.image -%}
          <img
            src="{{ gift_card.image | image_url: width: 400 }}"
            alt="{{ 'gift_card.card' | t }}"
            class="mx-auto mb-4 rounded"
            width="400"
            height="{{ 400 | divided_by: gift_card.image.aspect_ratio | round }}"
            loading="eager"
          >
        {%- endif -%}

        <p class="text-3xl font-bold">{{ gift_card.balance | money }}</p>

        {%- if gift_card.expired -%}
          <p class="mt-2 text-error">{{ 'gift_card.expired' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign formatted_expires_on = gift_card.expires_on | date: '%B %d, %Y' -%}
          <p class="mt-2 text-sm text-muted">
            {{ 'gift_card.expires_on' | t: expires_on: formatted_expires_on }}
          </p>
        {%- endif -%}
      </div>

      <div class="mb-6 rounded bg-muted/10 p-4">
        <p class="mb-1 text-sm text-muted">{{ 'gift_card.use_at_checkout' | t }}</p>
        <p class="select-all font-mono text-lg font-bold tracking-wider">{{ gift_card.code }}</p>
      </div>

      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="inline-block">
          <img
            src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
            width="120"
            height="40"
            loading="lazy"
          >
        </a>
      {%- endif -%}

      <a
        href="{{ shop.url }}"
        class="mt-6 inline-block rounded bg-primary px-6 py-3 text-sm font-medium text-primary-foreground transition-all duration-200 hover:shadow-md"
      >
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>
  </body>
</html>
