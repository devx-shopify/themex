{% doc %}
  Core Assets

  Loads base CSS, Tailwind CSS, and globally required JavaScript files.
  Included in layout/theme.liquid <head>.
  Cart modules load in dependency order: events → api → state → count → notify → actions → items → drawer.
{% enddoc %}

{{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'tailwind.css' | asset_url | stylesheet_tag: preload: true }}

{%- comment -%} Cart foundation — must load first {%- endcomment -%}
<script src="{{ 'cart-events.js' | asset_url }}" defer></script>
<script src="{{ 'cart-api.js' | asset_url }}" defer></script>
<script src="{{ 'cart-state.js' | asset_url }}" defer></script>
<script src="{{ 'cart-count.js' | asset_url }}" defer></script>
<script src="{{ 'cart-notify.js' | asset_url }}" defer></script>
<script src="{{ 'cart-actions.js' | asset_url }}" defer></script>

{%- comment -%} Cart drawer UI — not needed on cart page {%- endcomment -%}
{%- if template.name != 'cart' -%}
  <script src="{{ 'cart-items.js' | asset_url }}" defer></script>
  <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
{%- endif -%}

<script src="{{ 'product-form.js' | asset_url }}" defer></script>
<script src="{{ 'product-card.js' | asset_url }}" defer></script>
