{% doc %}
  Cart Line Item

  Renders a single cart line item with image, details, quantity stepper, and remove button.
  Used in both cart drawer and cart page.

  @param {line_item} item - Cart line item object (required)
  @param {number} line_index - 1-based line index for API calls (required)
{% enddoc %}

{%- liquid
  assign item = item | default: blank
  assign line_index = line_index | default: 1

  unless item != blank
    break
  endunless

  assign has_compare_price = false
  if item.original_price > item.final_price
    assign has_compare_price = true
  endif
-%}

<div
  class="cart-line-item relative flex gap-4"
  id="CartItem-{{ item.key | replace: ':', '-' }}"
  data-item-key="{{ item.key }}"
  data-line-index="{{ line_index }}"
  data-cart-line="{{ line_index }}"
>
  <a
    href="{{ item.url }}"
    class="flex-shrink-0"
    aria-label="{{ item.product.title | escape }}"
  >
    {%- if item.image != blank -%}
      <img
        src="{{ item.image | image_url: width: 160 }}"
        alt="{{ item.image.alt | default: item.product.title | escape }}"
        width="80"
        height="{{ 80 | divided_by: item.image.aspect_ratio | round }}"
        loading="lazy"
        class="h-20 w-20 rounded border border-border object-cover"
      >
    {%- endif -%}
  </a>
  <div class="flex items-center justify-between gap-2 w-full">
    <div class="flex flex-1 flex-col gap-1">
      <a href="{{ item.url }}" class="text-sm font-medium leading-tight hover:underline">
        {{ item.product.title }}
      </a>

      {%- unless item.variant.title == blank or item.variant.title == 'Default Title' -%}
        <p class="text-xs text-muted">{{ item.variant.title }}</p>
      {%- endunless -%}

      {%- if item.properties.size > 0 -%}
        <dl class="mt-0.5 text-xs text-muted">
          {%- for property in item.properties -%}
            {%- assign property_first_char = property.first | slice: 0 -%}
            {%- unless property_first_char == '_' or property.last == blank -%}
              <div class="flex gap-1">
                <dt>{{ property.first }}:</dt>
                <dd>{{ property.last }}</dd>
              </div>
            {%- endunless -%}
          {%- endfor -%}
        </dl>
      {%- endif -%}

      {%- if item.selling_plan_allocation != blank and item.selling_plan_allocation.selling_plan.name != 'Default' -%}
        <p class="text-xs text-muted">
          {{ item.selling_plan_allocation.selling_plan.name }}
        </p>
      {%- endif -%}

      <div class="flex items-center gap-2">
        <span class="text-sm font-medium" data-cart-line-price="{{ line_index }}">
          {{ item.final_line_price | money }}
        </span>
        {%- if has_compare_price -%}
          <s class="text-xs text-muted" data-cart-line-compare-price="{{ line_index }}">
            {{ item.original_price | times: item.quantity | money }}
          </s>
        {%- endif -%}
      </div>

      {%- if item.line_level_discount_allocations.size > 0 -%}
        <ul class="mt-1" data-cart-line-discount="{{ line_index }}">
          {%- for discount in item.line_level_discount_allocations -%}
            <li class="flex items-center gap-1 text-xs">
              {% render 'icon-discount', size: 12 %}
              {{ discount.discount_application.title }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <p
        class="text-xs text-error mt-1"
        data-cart-line-error="{{ line_index }}"
        data-error-message="{{ 'cart.update_cart_error' | t | escape }}"
        hidden
      ></p>
    </div>

    <div class="inline-flex items-center rounded border border-border">
      <button
        type="button"
        class="flex h-6 w-8 items-center justify-center text-muted transition-colors hover:text-foreground"
        data-quantity-minus
        data-line-index="{{ line_index }}"
        aria-label="{%- if item.quantity == 1 -%}{{ 'cart.remove' | t }}: {{ item.product.title | escape }}{%- else -%}{{ 'cart.decrease' | t: product: item.product.title }}{%- endif -%}"
      >
        <span
          data-icon-delete
          {% unless item.quantity == 1 %}
            hidden
          {% endunless %}
          class="hover:text-error"
        >
          {%- render 'icon-delete', size: 14 -%}
        </span>
        <span
          data-icon-minus
          {% if item.quantity == 1 %}
            hidden
          {% endif %}
        >
          {%- render 'icon-minus', size: 14 -%}
        </span>
      </button>
      <input
        type="number"
        value="{{ item.quantity }}"
        min="0"
        max="99"
        disabled
        class="h-6 w-8 border-x border-border bg-transparent text-center text-xs [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
        data-line-index="{{ line_index }}"
        data-cart-line-qty="{{ line_index }}"
        aria-label="{{ 'cart.quantity_input_label' | t: product: item.product.title }}"
      >
      <button
        type="button"
        class="flex h-6 w-8 items-center justify-center text-muted transition-colors hover:text-foreground"
        data-quantity-plus
        data-line-index="{{ line_index }}"
        aria-label="{{ 'cart.increase' | t: product: item.product.title }}"
      >
        {% render 'icon-plus', size: 14 %}
      </button>
    </div>
  </div>
</div>
