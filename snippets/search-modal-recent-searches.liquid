{% doc %}
  Search Modal Recent Searches

  Container with loader and list for recent searches,
  populated via Section Rendering API by search-recent-searches.js.

  @example
  {% render 'search-modal-recent-searches' %}
{% enddoc %}

<div id="recent-searches-section" class="mb-6 hidden">
  <div class="mb-3 flex items-center justify-between">
    <h3 class="text-sm font-semibold uppercase tracking-wider text-muted">
      {{ 'search.recent_searches' | t }}
    </h3>
    <button
      type="button"
      id="clear-recent-searches"
      class="text-xs text-muted transition-colors hover:text-foreground"
    >
      {{ 'search.clear_history' | t }}
    </button>
  </div>

  {%- comment -%} Skeleton loader {%- endcomment -%}
  <div id="recent-searches-loader" class="hidden space-y-2">
    {%- for i in (1..3) -%}
      <div class="h-8 animate-pulse rounded bg-muted/10"></div>
    {%- endfor -%}
  </div>

  {%- comment -%} Results list (populated by JS via Section Rendering API) {%- endcomment -%}
  <ul id="recent-searches-list" class="space-y-1"></ul>
</div>
