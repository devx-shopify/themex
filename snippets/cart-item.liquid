{% doc %}
  Cart Item

  Renders a single cart item in the cart drawer.

  @param {line_item} item - Cart line item (required)

  @example
  {% render 'cart-item', item: item %}
{% enddoc %}

{%- liquid
  assign item = item | default: blank

  unless item != blank
    break
  endunless
-%}

<div
  class="cart-item relative flex gap-3 border-b border-border py-4 first:pt-0 transition-opacity duration-300"
  data-key="{{ item.key }}"
>
  {%- comment -%} Image {%- endcomment -%}
  <a
    href="{{ item.url }}"
    class="cart-item-image block h-20 w-20 flex-shrink-0 overflow-hidden rounded border border-border"
  >
    {%- if item.image -%}
      <img
        src="{{ item.image | image_url: width: 160 }}"
        alt="{{ item.title | escape }}"
        width="80"
        height="80"
        loading="lazy"
        class="h-full w-full object-cover"
      >
    {%- endif -%}
  </a>

  <div class="flex w-full items-start justify-between">
    {%- comment -%} Details {%- endcomment -%}
    <div class="cart-item-details flex flex-1 flex-col justify-start gap-1">
      <div>
        <a href="{{ item.url }}" class="text-sm font-medium leading-tight">
          {{ item.product.title | escape }}
        </a>
        {%- if item.variant.title != 'Default Title' -%}
          <p class="mt-0.5 text-xs text-muted">{{ item.variant.title }}</p>
        {%- endif -%}
        {%- for property in item.properties -%}
          {%- if property.last != blank -%}
            <p class="mt-0.5 text-xs text-muted">
              {{ property.first | escape }}: {{ property.last | escape }}
            </p>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="flex flex-col gap-1">
        <div class="flex items-center gap-1">
          <span class="text-sm font-medium">{{ item.final_line_price | money }}</span>
          {%- if item.original_line_price != item.final_line_price -%}
            <s class="text-sm text-muted">{{ item.original_line_price | money }}</s>
          {%- endif -%}
        </div>
        {%- for discount_allocation in item.discount_allocations -%}
          <p class="flex items-center gap-1 text-sm">
            {% render 'icon-discount', class: 'w-3 h-3', size: 8 %}
            {{ discount_allocation.discount_application.title | escape }}
          </p>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Quantity controls {%- endcomment -%}
    <div class="flex items-center rounded border border-border">
      <button
        type="button"
        class="flex h-8 w-8 items-center justify-center text-muted transition-colors hover:text-foreground"
        data-quantity="{%- if item.quantity <= 1 -%}0{%- else -%}{{ item.quantity | minus: 1 }}{%- endif -%}"
        aria-label="{%- if item.quantity <= 1 -%}{{ 'cart.remove' | t }}{%- else -%}{{ 'cart.decrease' | t: product: item.product.title }}{%- endif -%}"
      >
        {%- if item.quantity <= 1 -%}
          {% render 'icon-delete', size: 14 %}
        {%- else -%}
          {% render 'icon-minus', size: 14 %}
        {%- endif -%}
      </button>
      <span class="min-w-[1.5rem] text-center text-sm">
        {{ item.quantity }}
      </span>
      <button
        type="button"
        class="flex h-8 w-8 items-center justify-center text-muted transition-colors hover:text-foreground"
        data-quantity="{{ item.quantity | plus: 1 }}"
        aria-label="{{ 'cart.increase' | t: product: item.product.title }}"
      >
        {% render 'icon-plus', size: 14 %}
      </button>
    </div>
  </div>
</div>
