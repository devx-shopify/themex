{% doc %}
  Hamburger Menu Icon

  @param {string} [class] - Additional CSS classes (optional)
  @param {number} size - Icon size in pixels (default: 20)
{% enddoc %}

{%- assign icon_size = size | default: 20 -%}
<svg
  class="{{ class }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <line x1="3" y1="12" x2="21" y2="12"/>
  <line x1="3" y1="6" x2="21" y2="6"/>
  <line x1="3" y1="18" x2="21" y2="18"/>
</svg>
