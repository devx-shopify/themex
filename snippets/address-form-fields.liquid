  </label>
  <input
    type="text"
    name="address[address1]"
    id="{{ form.id }}_address1"
    value="{{ form.address1 }}"
    autocomplete="address-line1"
    class="w-full rounded border border-border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
  >
</div>

<div>
  <label for="{{ form.id }}_address2" class="mb-1.5 block text-sm font-medium">
    {{ 'customers.addresses.address2' | t }}
  </label>
  <input
    type="text"
    name="address[address2]"
    id="{{ form.id }}_address2"
