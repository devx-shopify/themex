    </label>
    <input
      type="text"
      name="address[zip]"
      id="{{ form.id }}_zip"
      value="{{ form.zip }}"
      autocomplete="postal-code"
      class="w-full rounded border border-border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
    >
  </div>
</div>

<div class="grid grid-cols-2 gap-4">
  <div>
    <label for="{{ form.id }}_country" class="mb-1.5 block text-sm font-medium">
      {{ 'customers.addresses.country' | t }}
    </label>
    <select
      name="address[country]"
      id="{{ form.id }}_country"
      autocomplete="country"
      class="w-full rounded border border-border bg-transparent px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
      data-address-country-select
      data-default="{{ form.country }}"
    >
      {{ all_country_option_tags }}
    </select>
  </div>
  <div>
    <label for="{{ form.id }}_province" class="mb-1.5 block text-sm font-medium">
      {{ 'customers.addresses.province' | t }}
