<div class="grid grid-cols-2 gap-4">
  <div>
    <label for="{{ form.id }}_city" class="mb-1.5 block text-sm font-medium">
      {{ 'customers.addresses.city' | t }}
    </label>
    <input
      type="text"
      name="address[city]"
      id="{{ form.id }}_city"
      value="{{ form.city }}"
      autocomplete="address-level2"
      class="w-full rounded border border-border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
