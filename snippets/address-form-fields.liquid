{% doc %}
  Address Form Fields

  Renders the shared address form fields used in both
  new address and edit address forms.

  @param {form} form - Shopify form object (required)

  @example
  {% render 'address-form-fields', form: form %}
{% enddoc %}

{%- liquid
  assign form = form | default: blank

  unless form != blank
    break
  endunless
-%}

<div class="grid grid-cols-2 gap-4">
  <div>
    <label for="{{ form.id }}_first_name" class="mb-1.5 block text-sm font-medium">
      {{ 'customers.addresses.first_name' | t }}
    </label>
    <input
      type="text"
      name="address[first_name]"
      id="{{ form.id }}_first_name"
      value="{{ form.first_name }}"
      autocomplete="given-name"
      class="w-full rounded border border-border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
    >
  </div>
  <div>
    <label for="{{ form.id }}_last_name" class="mb-1.5 block text-sm font-medium">
      {{ 'customers.addresses.last_name' | t }}
    </label>
    <input
      type="text"
      name="address[last_name]"
      id="{{ form.id }}_last_name"
      value="{{ form.last_name }}"
      autocomplete="family-name"
      class="w-full rounded border border-border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
    >
  </div>
</div>

<div>
  <label for="{{ form.id }}_company" class="mb-1.5 block text-sm font-medium">
    {{ 'customers.addresses.company' | t }}
  </label>
  <input
    type="text"
    name="address[company]"
    id="{{ form.id }}_company"
    value="{{ form.company }}"
    autocomplete="organization"
    class="w-full rounded border border-border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
  >
</div>

<div>
