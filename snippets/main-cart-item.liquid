{% doc %}
  Main Cart Item

  Renders a single cart line item for the full cart page.
  Form-based quantity controls — no AJAX.

  @param {line_item} item - Cart line item (required)

  @example
  {% render 'main-cart-item', item: item %}
{% enddoc %}

{%- liquid
  assign item = item | default: blank

  unless item != blank
    break
  endunless
-%}

<div class="cart-item flex gap-4 py-6 first:pt-0">
  {%- comment -%} Image {%- endcomment -%}
  {%- if item.image -%}
    <a href="{{ item.url }}" class="block w-24 flex-shrink-0 overflow-hidden rounded border border-border md:w-32">
      <img
        src="{{ item.image | image_url: width: 320 }}"
        alt="{{ item.title | escape }}"
        width="160"
        height="160"
        loading="lazy"
        class="h-full w-full object-cover"
      >
    </a>
  {%- endif -%}

  {%- comment -%} Details {%- endcomment -%}
  <div class="flex flex-1 flex-col justify-between gap-4 min-w-0">
    <div>
      <a href="{{ item.url }}" class="text-sm font-medium md:text-base">
        {{ item.product.title | escape }}
      </a>

      {%- if item.variant.title != 'Default Title' -%}
        <p class="mt-1 text-sm text-muted">{{ item.variant.title }}</p>
      {%- endif -%}

      {%- for property in item.properties -%}
        {%- if property.last != blank -%}
          <p class="mt-0.5 text-xs text-muted">{{ property.first | escape }}: {{ property.last | escape }}</p>
        {%- endif -%}
      {%- endfor -%}

      <p class="mt-2 text-sm font-medium">
        {{ item.final_line_price | money }}
      </p>

      {%- if item.original_line_price != item.final_line_price -%}
        <s class="text-xs text-muted">{{ item.original_line_price | money }}</s>
      {%- endif -%}
    </div>

    {%- comment -%} Quantity & remove {%- endcomment -%}
    <div class="flex items-center justify-between">
      <div class="flex items-center rounded border border-border">
        <label class="sr-only" for="quantity-{{ item.key }}">
          {{ 'cart.quantity_input_label' | t: product: item.product.title }}
        </label>
        <input
          type="number"
          id="quantity-{{ item.key }}"
          name="updates[{{ item.key }}]"
          value="{{ item.quantity }}"
          min="0"
          max="99"
          form="cart-form"
          class="h-10 w-16 bg-transparent text-center text-sm font-medium [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
        >
      </div>

      <a
        href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0"
        class="text-sm text-muted underline transition-colors hover:text-foreground"
      >
        {{ 'cart.remove' | t }}
      </a>
    </div>
  </div>
</div>
