{% doc %}
  Search Modal Recently Viewed Products

  Container with loader and horizontal scroll list for recently viewed products,
  populated via Section Rendering API by search-recently-viewed.js.

  @example
  {% render 'search-modal-recently-viewed' %}
{% enddoc %}

<div id="recently-viewed-section" class="mb-6 hidden">
  <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-muted">
    {{ 'search.recently_viewed' | t }}
  </h3>

  {%- comment -%} Skeleton loader {%- endcomment -%}
  <div id="recently-viewed-loader" class="hidden gap-3">
    {%- for i in (1..3) -%}
      <div class="flex-[0_0_45%] min-w-0 sm:flex-[0_0_35%] lg:flex-[0_0_28%]">
        <div class="animate-pulse rounded border border-border p-3">
          <div class="aspect-[4/5] rounded bg-muted/10"></div>
          <div class="mt-3 space-y-2">
            <div class="h-4 w-3/4 rounded bg-muted/10"></div>
            <div class="h-4 w-1/2 rounded bg-muted/10"></div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} Products list (populated by JS via Section Rendering API) {%- endcomment -%}
  <div
    id="recently-viewed-list"
    class="scrollbar-hide flex gap-3 overflow-x-auto"
  ></div>
</div>
