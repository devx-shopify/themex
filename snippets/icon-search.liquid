{% doc %}
  Search Icon

  @param {string} [class] - Additional CSS classes (optional)
  @param {number} size - Icon size in pixels (default: 20)
{% enddoc %}

{%- assign icon_size = size | default: 20 -%}
<svg
  class="{{ class }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <circle cx="11" cy="11" r="8"/>
  <line x1="21" y1="21" x2="16.65" y2="16.65"/>
</svg>
