<cart-drawer class="cart-drawer" id="cart-drawer">
  {%- comment -%} Overlay {%- endcomment -%}
  <div
    class="cart-drawer-overlay fixed inset-0 z-[70] hidden bg-black/50 opacity-0 transition-opacity duration-300"
    data-cart-overlay
  ></div>

  {%- comment -%} Drawer panel {%- endcomment -%}
  <div
    class="cart-drawer-panel fixed inset-y-0 right-0 z-[80] flex flex-col justify-between w-full max-w-md translate-x-full bg-background shadow-xl transition-transform duration-300"
    data-cart-panel
  >
    <div class="cart-drawer-panel-content">
      {%- comment -%} Header {%- endcomment -%}
      <div class="flex items-center justify-between border-b border-border px-4 py-4">
        <h2 class="text-lg font-bold">
          {{ 'cart.shopping_cart' | t }} (<span data-cart-heading-count>{{ cart.item_count }}</span>)
        </h2>
        <button
          type="button"
          class="transition-colors hover:text-muted"
          data-cart-close
          aria-label="{{ 'cart.close' | t }}"
        >
          {% render 'icon-close', size: 20 %}
        </button>
      </div>

      {%- comment -%} Notification - slides down below header {%- endcomment -%}
      <div
        class="overflow-hidden max-h-0 transition-all duration-300 ease-in-out"
        data-cart-notification
        role="alert"
        aria-live="assertive"
        aria-atomic="true"
      >
        <div class="px-4 py-3 text-sm font-medium" data-notification-content></div>
      </div>

      {%- comment -%} Cart items manager — handles all item DOM updates {%- endcomment -%}
      <cart-items-manager data-context="drawer">
        {%- comment -%} Optimistic UI templates {%- endcomment -%}
        {% render 'cart-templates' %}

        {%- comment -%} Cart items {%- endcomment -%}
        <div class="cart-drawer-items flex-1 overflow-y-auto px-4 py-4" data-cart-items>
          {%- if cart.item_count > 0 -%}
            {%- for item in cart.items -%}
              {% render 'cart-item', item: item %}
            {%- endfor -%}
          {%- else -%}
            <div class="flex h-full flex-col items-center justify-center text-center" data-cart-empty>
              <p class="mb-4 text-muted">{{ 'cart.empty_cart' | t }}</p>
              <a
                href="{{ routes.all_products_collection_url }}"
                class="rounded bg-primary px-6 py-2 text-sm font-medium text-primary-foreground transition-all duration-200 hover:shadow-md"
              >
                {{ 'general.continue_shopping' | t }}
              </a>
            </div>
          {%- endif -%}
        </div>
      </cart-items-manager>
    </div>

    {%- comment -%} Footer {%- endcomment -%}
    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer-footer border-t border-border px-4 py-4" data-cart-footer>
        {%- comment -%} Discount applications {%- endcomment -%}
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <div class="mb-3 space-y-1" data-cart-discounts>
            {%- for discount_application in cart.cart_level_discount_applications -%}
              <div class="flex items-center justify-between text-sm text-success">
                <span>{{ discount_application.title | escape }}</span>
                <span>-{{ discount_application.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="mb-4 flex items-center justify-between">
          <span class="text-sm font-medium">{{ 'cart.subtotal' | t }}</span>
          <div class="text-right">
            {%- if cart.original_total_price != cart.total_price -%}
              <s class="block text-xs text-muted">{{ cart.original_total_price | money }}</s>
            {%- endif -%}
            <span class="text-lg font-bold" data-cart-subtotal>{{ cart.total_price | money }}</span>
          </div>
        </div>
        <a
          href="/checkout"
          class="relative block w-full rounded bg-primary py-3 text-center text-sm font-medium text-primary-foreground transition-all duration-200 hover:shadow-md"
          data-cart-checkout
          aria-busy="false"
        >
          <span data-checkout-text>{{ 'cart.checkout' | t }}</span>
          <span data-checkout-loader class="hidden absolute inset-0 flex items-center justify-center">
            {% render 'icon-spinner', size: 20 %}
          </span>
        </a>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart Drawer",
  "class": "cart-drawer-section"
}
{% endschema %}
