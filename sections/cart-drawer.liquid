<cart-drawer
  class="cart-drawer"
  data-section-id="{{ section.id }}"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'cart.shopping_cart' | t }}"
  hidden
>
  {%- comment -%} Overlay backdrop {%- endcomment -%}
  <div
    class="cart-drawer__overlay fixed inset-0 z-[999] bg-black/50 opacity-0 transition-opacity duration-300"
    data-cart-overlay
  ></div>

  {%- comment -%} Drawer panel {%- endcomment -%}
  <div
    class="cart-drawer__panel fixed inset-y-0 right-0 z-[999] flex w-full max-w-md translate-x-full flex-col bg-background transition-transform duration-300"
    data-cart-panel
  >
    {%- comment -%} Drawer header {%- endcomment -%}
    <div class="flex items-center justify-between border-b border-border px-5 py-4">
      <h2 class="text-lg font-medium">
        {{ 'cart.shopping_cart' | t }}
        <span class="text-sm font-normal text-muted" data-cart-header-count{% if cart.item_count == 0 %} hidden{% endif %}>{% if cart.item_count > 0 %}({{ cart.item_count }}){% endif %}</span>
      </h2>
      <button
        type="button"
        class="flex items-center justify-center text-muted transition-colors hover:text-foreground"
        data-cart-close
        aria-label="{{ 'cart.close' | t }}"
      >
        {% render 'icon-close', size: 20 %}
      </button>
    </div>

    {%- comment -%} Cart items — hidden when cart is empty {%- endcomment -%}
    <div class="flex-1 overflow-y-auto px-5" data-cart-items{% if cart.item_count == 0 %} hidden{% endif %}>
      {%- comment -%} Skeleton loading state — inside items container so it replaces in place when the first item morphs in {%- endcomment -%}
      <div
        class="animate-pulse py-4 border-b border-border"
        data-cart-skeleton
        {% if cart.item_count > 0 %}hidden{% endif %}
      >
        <div class="flex gap-4">
          <div class="h-20 w-20 flex-shrink-0 rounded bg-muted/10"></div>
          <div class="flex flex-1 flex-col gap-2 py-1">
            <div class="h-4 w-2/3 rounded bg-muted/10"></div>
            <div class="h-3 w-1/3 rounded bg-muted/10"></div>
            <div class="h-4 w-1/4 rounded bg-muted/10"></div>
          </div>
          <div class="h-6 w-20 flex-shrink-0 rounded bg-muted/10"></div>
        </div>
      </div>
      {%- for item in cart.items -%}
        <div class="py-4 border-b border-border">
          {% render 'cart-line-item', item: item, line_index: forloop.index %}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Cart footer — hidden when cart is empty {%- endcomment -%}
    <div class="border-t border-border px-5 py-4" data-cart-footer{% if cart.item_count == 0 %} hidden{% endif %}>
      {%- comment -%} Cart level discounts {%- endcomment -%}
      {%- if cart.cart_level_discount_applications.size > 0 -%}
        <ul class="mb-3">
          {%- for discount in cart.cart_level_discount_applications -%}
            <li class="flex items-center justify-between text-sm text-success">
              <span class="flex items-center gap-1">
                {% render 'icon-discount', size: 14 %}
                {{ discount.title }}
              </span>
              <span>-{{ discount.total_allocated_amount | money }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} Subtotal {%- endcomment -%}
      <div class="mb-1 flex items-center justify-between">
        <span class="text-sm font-medium">{{ 'cart.subtotal' | t }}</span>
        <span class="text-base font-semibold" data-cart-total>{{ cart.total_price | money }}</span>
      </div>

      {%- comment -%} Checkout button {%- endcomment -%}
      <button
        type="button"
        data-cart-checkout
        data-checkout-url="{{ routes.cart_url | append: '/checkout' }}"
        class="mb-2 flex w-full items-center justify-center gap-2 rounded bg-foreground px-6 py-3 text-sm font-medium text-background transition-all duration-200 hover:shadow-md"
      >
        <span data-checkout-text>{{ 'cart.checkout' | t }}</span>
        <span data-checkout-spinner hidden>{% render 'icon-spinner', size: 16, class: 'text-background' %}</span>
      </button>
    </div>

    {%- comment -%} Empty state — hidden when cart has items {%- endcomment -%}
    <div class="flex flex-1 flex-col items-center justify-center gap-4 px-5 text-center" data-cart-empty{% if cart.item_count > 0 %} hidden{% endif %}>
      <p class="text-muted">{{ 'cart.empty_cart' | t }}</p>
      <a
        href="{{ routes.collections_url }}"
        class="rounded bg-foreground px-6 py-3 text-sm font-medium text-background transition-all duration-200 hover:shadow-md"
      >
        {{ 'cart.shop_now' | t }}
      </a>
    </div>
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart Drawer",
  "class": "cart-drawer-section"
}
{% endschema %}
