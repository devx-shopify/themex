{%- comment -%}
  Customer Addresses

  Displays address management with add/edit form and address list.
  Uses Shopify's built-in country/province selectors.
{%- endcomment -%}

<div class="page-width py-10 md:py-16">
  <div class="mx-auto max-w-3xl">
    <div class="mb-8 flex items-center justify-between">
      <h1 class="text-3xl font-bold md:text-4xl">{{ 'customers.addresses.title' | t }}</h1>
      <a href="{{ routes.account_url }}" class="text-sm text-muted underline hover:text-foreground">
        {{ 'customers.order.back' | t }}
      </a>
    </div>

    {%- if customer -%}
      {%- comment -%} Add new address button {%- endcomment -%}
      <div class="mb-6">
        <button
          type="button"
          class="rounded bg-primary px-6 py-2.5 text-sm font-medium text-primary-foreground transition-all duration-200 hover:shadow-md"
          data-toggle-new-address
        >
          {{ 'customers.addresses.add_address' | t }}
        </button>
      </div>

      {%- comment -%} New address form (hidden by default) {%- endcomment -%}
      <div class="mb-8 hidden rounded border border-border p-6" data-new-address-form>
        <h2 class="mb-4 text-lg font-bold">{{ 'customers.addresses.add_address' | t }}</h2>

        {% form 'customer_address', customer.new_address, class: 'space-y-4' %}
          {%- if form.errors -%}
            <div class="rounded border border-error/20 bg-error/5 p-4 text-sm text-error">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          {% render 'address-form-fields', form: form %}

          <div class="flex items-center gap-2">
            <input type="checkbox" name="address[default]" id="new_address_default" value="1" class="h-4 w-4 rounded border-border accent-primary">
            <label for="new_address_default" class="text-sm">{{ 'customers.addresses.set_default' | t }}</label>
          </div>

          <div class="flex gap-3 pt-2">
            <button
              type="submit"
              class="rounded bg-primary px-6 py-2.5 text-sm font-medium text-primary-foreground transition-all duration-200 hover:shadow-md"
            >
              {{ 'customers.addresses.save' | t }}
            </button>
            <button
              type="button"
              class="rounded border border-border px-6 py-2.5 text-sm font-medium transition-colors hover:bg-muted/10"
              data-toggle-new-address
            >
              {{ 'customers.account.cancel' | t }}
            </button>
          </div>
        {% endform %}
      </div>

      {%- comment -%} Address list {%- endcomment -%}
      {%- if customer.addresses.size > 0 -%}
        <div class="space-y-4">
          {%- for address in customer.addresses -%}
            <div class="rounded border border-border p-6" data-address-card="{{ address.id }}">
              {%- comment -%} Display mode {%- endcomment -%}
              <div data-address-display="{{ address.id }}">
                <div class="flex items-start justify-between">
                  <div class="text-sm">
                    {%- if address == customer.default_address -%}
                      <span class="mb-2 inline-block rounded-full bg-primary px-2 py-0.5 text-xs font-medium text-primary-foreground">
                        {{ 'customers.addresses.default_address' | t }}
                      </span>
                    {%- endif -%}
                    <p class="font-medium">{{ address.first_name }} {{ address.last_name }}</p>
                    {%- if address.company != blank -%}<p class="text-muted">{{ address.company }}</p>{%- endif -%}
                    <p class="text-muted">{{ address.address1 }}</p>
                    {%- if address.address2 != blank -%}<p class="text-muted">{{ address.address2 }}</p>{%- endif -%}
                    <p class="text-muted">{{ address.city }}, {{ address.province }} {{ address.zip }}</p>
                    <p class="text-muted">{{ address.country }}</p>
                    {%- if address.phone != blank -%}<p class="text-muted">{{ address.phone }}</p>{%- endif -%}
                  </div>
                  <div class="flex gap-3">
                    <button
                      type="button"
                      class="text-sm underline hover:text-muted"
                      data-edit-address="{{ address.id }}"
                    >
                      {{ 'customers.addresses.edit' | t }}
                    </button>
                    <form method="post" action="{{ address.url }}" class="inline">
                      <input type="hidden" name="_method" value="delete">
                      <button
                        type="submit"
                        class="text-sm text-error underline hover:text-error/80"
                        onclick="return confirm('{{ 'customers.addresses.delete_confirm' | t }}')"
                      >
                        {{ 'customers.addresses.delete' | t }}
                      </button>
                    </form>
                  </div>
                </div>
              </div>

              {%- comment -%} Edit mode (hidden) {%- endcomment -%}
              <div class="hidden" data-address-edit="{{ address.id }}">
                <h3 class="mb-4 text-base font-bold">{{ 'customers.addresses.edit' | t }}</h3>
                {% form 'customer_address', address, class: 'space-y-4' %}
                  {% render 'address-form-fields', form: form %}

                  <div class="flex items-center gap-2">
                    <input
                      type="checkbox"
                      name="address[default]"
                      id="address_default_{{ address.id }}"
                      value="1"
                      class="h-4 w-4 rounded border-border accent-primary"
                      {% if address == customer.default_address %}checked{% endif %}
                    >
                    <label for="address_default_{{ address.id }}" class="text-sm">{{ 'customers.addresses.set_default' | t }}</label>
                  </div>

                  <div class="flex gap-3 pt-2">
                    <button
                      type="submit"
                      class="rounded bg-primary px-6 py-2.5 text-sm font-medium text-primary-foreground transition-all duration-200 hover:shadow-md"
                    >
                      {{ 'customers.addresses.save' | t }}
                    </button>
                    <button
                      type="button"
                      class="rounded border border-border px-6 py-2.5 text-sm font-medium transition-colors hover:bg-muted/10"
                      data-cancel-edit="{{ address.id }}"
                    >
                      {{ 'customers.account.cancel' | t }}
                    </button>
                  </div>
                {% endform %}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="rounded border border-border py-12 text-center">
          <p class="text-muted">{{ 'customers.addresses.no_addresses' | t }}</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<script src="{{ 'customer-addresses.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Customer Addresses",
  "class": "customer-addresses-section",
  "settings": []
}
{% endschema %}
