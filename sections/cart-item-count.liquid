{%- comment -%}
  Cart Item Count Section

  Used by the Section Rendering API to update cart count badges dynamically.
  Not meant to be added to theme editor — used only for AJAX cart updates.
{%- endcomment -%}

<span class="cart-item-count{%- if cart.item_count == 0 %} hidden{%- endif -%}" data-cart-count="{{ cart.item_count }}">
  {%- if cart.item_count > 0 -%}{{ cart.item_count }}{%- endif -%}
</span>

{% schema %}
{
  "name": "Cart Item Count",
  "settings": []
}
{% endschema %}
