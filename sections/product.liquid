{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<section class="product-section page-width py-10 lg:py-16" data-product-id="{{ product.id }}" data-product-section>
  <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
    {%- comment -%} Product media {%- endcomment -%}
    <div class="product-media">
      {%- comment -%} Mobile: horizontal scroll {%- endcomment -%}
      <div
        class="flex snap-x snap-mandatory gap-2 overflow-x-auto scrollbar-hide lg:hidden"
        data-product-gallery-scroll
      >
        {%- for media in product.media -%}
          <div
            class="w-full flex-none snap-start"
            data-media-id="{{ media.id }}"
          >
            {%- if media.media_type == 'image' -%}
              <img
                src="{{ media | image_url: width: 800 }}"
                alt="{{ media.alt | default: product.title | escape }}"
                width="800"
                height="{{ 800 | divided_by: media.aspect_ratio | round }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                class="w-full rounded-lg"
              >
            {%- elsif media.media_type == 'video' -%}
              {{ media | video_tag: autoplay: true, controls: false, muted: true, class: 'w-full rounded-lg' }}
            {%- elsif media.media_type == 'external_video' -%}
              {{ media | external_video_tag: class: 'w-full rounded-lg' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Desktop: grid {%- endcomment -%}
      <div class="hidden gap-2 lg:grid lg:grid-cols-2">
        {%- for media in product.media -%}
          <div
            class="{% if media.id == current_variant.featured_media.id %}col-span-2{% else %}col-span-1{% endif %}"
            data-media-id="{{ media.id }}"
          >
            {%- if media.media_type == 'image' -%}
              <img
                src="{{ media | image_url: width: 1000 }}"
                alt="{{ media.alt | default: product.title | escape }}"
                width="1000"
                height="{{ 1000 | divided_by: media.aspect_ratio | round }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                class="w-full rounded-lg"
              >
            {%- elsif media.media_type == 'video' -%}
              {{ media | video_tag: autoplay: true, controls: false, muted: true, class: 'w-full rounded-lg' }}
            {%- elsif media.media_type == 'external_video' -%}
              {{ media | external_video_tag: class: 'w-full rounded-lg' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Product info {%- endcomment -%}
    <div class="product-info lg:sticky lg:top-24 lg:self-start">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <h1 class="mb-2 text-3xl font-bold lg:text-4xl" {{ block.shopify_attributes }}>
              {{ product.title }}
            </h1>

            {%- if product.vendor != blank -%}
              <p class="mb-4 text-sm text-muted">{{ product.vendor }}</p>
            {%- endif -%}

          {%- when 'price' -%}
            <div class="mb-6 flex items-center gap-3" {{ block.shopify_attributes }}>
              <span class="text-2xl font-semibold" data-product-price>
                {{ current_variant.price | money }}
              </span>

              <s
                class="text-base text-muted{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}"
                data-product-compare-price
              >
                {%- if current_variant.compare_at_price > current_variant.price -%}
                  {{ current_variant.compare_at_price | money }}
                {%- endif -%}
              </s>

              {%- liquid
                assign discount = 0
                if current_variant.compare_at_price > current_variant.price
                  assign discount = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
                endif
              -%}
              <span
                class="rounded bg-error/10 px-2 py-0.5 text-xs font-medium text-error{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}"
                data-product-discount
              >
                {%- if current_variant.compare_at_price > current_variant.price -%}
                  {{ discount }}% off
                {%- endif -%}
              </span>
            </div>

          {%- when 'variant_selector' -%}
            {%- if product.has_only_default_variant == false -%}
              <div class="mb-6" {{ block.shopify_attributes }}>
                {%- liquid
                  assign product_options_string = ''
                  for option in product.options_with_values
                    unless forloop.first
                      assign product_options_string = product_options_string | append: ','
                    endunless
                    assign product_options_string = product_options_string | append: option.name
                  endfor
                -%}
                {% render 'variant-selector',
                  product: product,
                  options: product_options_string,
                  swatch_size: 'lg',
                  show_labels: true,
                  color_display: 'image'
                %}
              </div>
            {%- endif -%}

          {%- when 'buy_buttons' -%}
            <div class="mb-6" {{ block.shopify_attributes }}>
              {% render 'product-form', product: product %}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="prose max-w-none border-t border-border pt-6 text-sm" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}

          {%- when 'collapsible' -%}
            {%- if block.settings.heading != blank -%}
              <details class="border-t border-border" {{ block.shopify_attributes }}>
                <summary class="flex cursor-pointer items-center justify-between py-4 text-sm font-medium">
                  {{ block.settings.heading }}
                  <span class="transition-transform duration-200 [[open]>&]:rotate-180">
                    {% render 'icon-chevron-down', size: 16 %}
                  </span>
                </summary>
                <div class="pb-4 text-sm text-muted">
                  {{ block.settings.content }}
                </div>
              </details>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "product-section",
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_selector",
      "name": "Variant selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "collapsible",
      "name": "Collapsible tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shipping & Returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        { "type": "title" },
        { "type": "price" },
        { "type": "variant_selector" },
        { "type": "buy_buttons" },
        { "type": "description" }
      ]
    }
  ]
}
{% endschema %}
