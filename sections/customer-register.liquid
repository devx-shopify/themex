{%- comment -%}
  Customer Register

  Displays the customer registration form.
{%- endcomment -%}

<div class="page-width py-10 md:py-16">
  <div class="mx-auto max-w-md">
    <h1 class="mb-8 text-center text-3xl font-bold md:text-4xl">{{ 'customers.register.title' | t }}</h1>

    {% form 'customer_register', class: 'space-y-5' %}
      {%- if form.errors -%}
        <div class="rounded border border-error/20 bg-error/5 p-4 text-sm text-error">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="register_first_name" class="mb-1.5 block text-sm font-medium">
            {{ 'customers.register.first_name' | t }}
          </label>
          <input
            type="text"
            name="customer[first_name]"
            id="register_first_name"
            autocomplete="given-name"
            class="w-full rounded border border-border px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
          >
        </div>
        <div>
          <label for="register_last_name" class="mb-1.5 block text-sm font-medium">
            {{ 'customers.register.last_name' | t }}
          </label>
          <input
            type="text"
            name="customer[last_name]"
            id="register_last_name"
            autocomplete="family-name"
            class="w-full rounded border border-border px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
          >
        </div>
      </div>

      <div>
        <label for="register_email" class="mb-1.5 block text-sm font-medium">
          {{ 'customers.register.email' | t }}
        </label>
        <input
          type="email"
          name="customer[email]"
          id="register_email"
          autocomplete="email"
          required
          class="w-full rounded border border-border px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
        >
      </div>

      <div>
        <label for="register_password" class="mb-1.5 block text-sm font-medium">
          {{ 'customers.register.password' | t }}
        </label>
        <input
          type="password"
          name="customer[password]"
          id="register_password"
          autocomplete="new-password"
          required
          class="w-full rounded border border-border px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
        >
      </div>

      <button
        type="submit"
        class="w-full rounded bg-primary py-3 text-sm font-medium text-primary-foreground transition-all duration-200 hover:shadow-md"
      >
        {{ 'customers.register.submit' | t }}
      </button>
    {% endform %}

    <div class="mt-8 text-center">
      <p class="mb-2 text-sm text-muted">{{ 'customers.login.have_account' | t }}</p>
      <a href="{{ routes.account_login_url }}" class="text-sm font-medium underline hover:text-muted">
        {{ 'customers.login.submit' | t }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Register",
  "class": "customer-register-section",
  "settings": []
}
{% endschema %}
