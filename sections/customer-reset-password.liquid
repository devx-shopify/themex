{%- comment -%}
  Customer Reset Password

  Displays the password reset form (new password + confirmation).
{%- endcomment -%}

<div class="page-width py-10 md:py-16">
  <div class="mx-auto max-w-md">
    <h1 class="mb-8 text-center text-3xl font-bold md:text-4xl">{{ 'customers.reset_password.title' | t }}</h1>

    {% form 'reset_customer_password', class: 'space-y-5' %}
      {%- if form.errors -%}
        <div class="rounded border border-error/20 bg-error/5 p-4 text-sm text-error">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div>
        <label for="password" class="mb-1.5 block text-sm font-medium">
          {{ 'customers.reset_password.password' | t }}
        </label>
        <input
          type="password"
          name="customer[password]"
          id="password"
          autocomplete="new-password"
          required
          class="w-full rounded border border-border px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
        >
      </div>

      <div>
        <label for="password_confirmation" class="mb-1.5 block text-sm font-medium">
          {{ 'customers.reset_password.password_confirm' | t }}
        </label>
        <input
          type="password"
          name="customer[password_confirmation]"
          id="password_confirmation"
          autocomplete="new-password"
          required
          class="w-full rounded border border-border px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
        >
      </div>

      <button
        type="submit"
        class="w-full rounded bg-primary py-3 text-sm font-medium text-primary-foreground transition-all duration-200 hover:shadow-md"
      >
        {{ 'customers.reset_password.submit' | t }}
      </button>
    {% endform %}

    <div class="mt-8 text-center">
      <a href="{{ routes.account_login_url }}" class="text-sm text-muted underline hover:text-foreground">
        {{ 'customers.login.title' | t }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Reset Password",
  "class": "customer-reset-password-section",
  "settings": []
}
{% endschema %}
