{%- comment -%}
  Cart Page Section

  Standard form-based cart. No AJAX.
  Quantities update via form submission. Checkout via Shopify form action.
{%- endcomment -%}

<div class="cart-page page-width py-10 md:py-16">
  {%- if cart.item_count > 0 -%}
    <h1 class="mb-10 text-3xl font-bold md:text-4xl lg:text-5xl">
      {{ 'cart.shopping_cart' | t }} ({{ cart.item_count }})
    </h1>

    <form id="cart-form" action="{{ routes.cart_url }}" method="post">
      <div class="grid gap-8 lg:grid-cols-3 lg:gap-12">
        {%- comment -%} Cart items {%- endcomment -%}
        <div class="lg:col-span-2">
          <div class="divide-y divide-border">
            {%- for item in cart.items -%}
              {% render 'main-cart-item', item: item %}
            {%- endfor -%}
          </div>

          <button
            type="submit"
            class="mt-6 rounded border border-border px-6 py-2 text-sm font-medium transition-colors hover:bg-muted/10"
          >
            {{ 'cart.update' | t }}
          </button>
        </div>

        {%- comment -%} Order summary {%- endcomment -%}
        <div class="lg:col-span-1">
          <div class="rounded-lg border border-border p-6">
            <h2 class="mb-4 text-lg font-bold">{{ 'cart.subtotal' | t }}</h2>

            <div class="mb-4 flex items-center justify-between border-b border-border pb-4">
              <span class="text-sm text-muted">{{ 'cart.subtotal' | t }}</span>
              <span class="text-lg font-bold">{{ cart.total_price | money }}</span>
            </div>

            <p class="mb-6 text-xs text-muted">
              {{ 'cart.taxes_and_shipping_at_checkout' | t }}
            </p>

            <button
              type="submit"
              name="checkout"
              class="block w-full rounded bg-primary py-3 text-center text-sm font-medium text-primary-foreground transition-all duration-200 hover:shadow-md"
            >
              {{ 'cart.checkout' | t }}
            </button>

            <a
              href="{{ routes.all_products_collection_url }}"
              class="mt-3 block w-full rounded border border-border py-3 text-center text-sm font-medium transition-colors hover:bg-muted/10"
            >
              {{ 'general.continue_shopping' | t }}
            </a>
          </div>
        </div>
      </div>
    </form>

  {%- else -%}
    {%- comment -%} Empty cart {%- endcomment -%}
    <div class="flex min-h-[400px] flex-col items-center justify-center text-center">
      <div class="mb-4 text-muted">
        {% render 'icon-cart', size: 48 %}
      </div>
      <h1 class="mb-2 text-2xl font-bold">{{ 'cart.shopping_cart' | t }}</h1>
      <p class="mb-6 text-muted">{{ 'cart.empty_cart' | t }}</p>
      <a
        href="{{ routes.all_products_collection_url }}"
        class="rounded bg-primary px-8 py-3 text-sm font-medium text-primary-foreground transition-all duration-200 hover:shadow-md"
      >
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "class": "cart-section",
  "settings": []
}
{% endschema %}
