{{ 'collection-stylesheet.css' | asset_url | stylesheet_tag: preload: true }}

{%- liquid
  assign products_per_page = section.settings.products_per_page | default: 16
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign columns_mobile = section.settings.columns_mobile | default: 2

  case columns_desktop
    when 3
      assign grid_class_desktop = 'lg:grid-cols-3'
    when 4
      assign grid_class_desktop = 'lg:grid-cols-4'
    when 5
      assign grid_class_desktop = 'lg:grid-cols-5'
    else
      assign grid_class_desktop = 'lg:grid-cols-4'
  endcase

  case columns_mobile
    when 1
      assign grid_class_mobile = 'grid-cols-1'
    when 2
      assign grid_class_mobile = 'grid-cols-2'
    else
      assign grid_class_mobile = 'grid-cols-2'
  endcase

  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign has_filters = false
  if collection.filters.size > 0
    assign has_filters = true
  endif

  assign is_sort_active = false
  if current_sort != collection.default_sort_by
    assign is_sort_active = true
  endif

  assign has_active_filters = false
  for filter in collection.filters
    if filter.active_values.size > 0
      assign has_active_filters = true
      break
    endif
    if filter.type == 'price_range'
      if filter.min_value.value or filter.max_value.value
        assign has_active_filters = true
        break
      endif
    endif
  endfor
-%}

<section
  class="collection-section page-width py-10 md:py-16"
  data-collection-section
  data-section-id="{{ section.id }}"
>
  {%- comment -%} Collection header {%- endcomment -%}
  <div class="mb-8 pb-6">
    <h1 class="text-2xl font-semibold tracking-tight md:text-3xl lg:text-4xl">
      {{ collection.title }}

      {% comment %}
        <p class="text-sm text-muted">
          {{ 'collections.products_count' | t: count: collection.products_count }}
        </p>
      {% endcomment %}
    </h1>

    {%- if collection.description != blank -%}
      <div class="mt-2 max-w-2xl text-sm leading-relaxed text-muted md:text-base">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- comment -%} Toolbar: sort, filter toggle, product count {%- endcomment -%}
  <div
    class="mb-6 flex flex-wrap items-center justify-between gap-4 border-b border-border pb-4"
    data-collection-toolbar
  >
    <div class="flex items-center gap-4">
      {%- if has_filters -%}
        <button
          type="button"
          class="inline-flex items-center gap-2 text-sm font-medium lg:hidden"
          data-filter-toggle
          aria-expanded="false"
          aria-controls="filter-drawer"
        >
          {% render 'icon-filter', size: 16 %}
          {{ 'collections.filter' | t }}
        </button>
      {%- endif -%}
    </div>

    <div class="flex items-center gap-2">
      <label for="collection-sort" class="text-sm text-muted">{{ 'collections.sort_by' | t }}:</label>
      <select
        id="collection-sort"
        class="rounded border border-border bg-transparent px-3 py-1.5 text-sm"
        data-collection-sort
      >
        {%- for option in collection.sort_options -%}
          <option
            value="{{ option.value }}"
            {% if option.value == current_sort %}
              selected
            {% endif %}
          >
            {{ option.name }}
          </option>
        {%- endfor -%}
      </select>
    </div>
  </div>

  {%- comment -%} Active filters {%- endcomment -%}
  <div class="mb-4" data-active-filters-container>
    {% render 'active-filters', collection: collection %}
  </div>

  <div class="flex gap-8">
    {%- if has_filters -%}
      {%- comment -%} Desktop sidebar filters {%- endcomment -%}
      <aside class="hidden sticky top-[72px] w-60 h-full flex-shrink-0 lg:block" data-filters-sidebar>
        {% render 'collection-filters', collection: collection %}
      </aside>
    {%- endif -%}

    {%- comment -%} Product grid + pagination {%- endcomment -%}
    <div class="relative flex-1 transition-opacity duration-300" data-collection-products>
      <div
        class="absolute inset-0 z-20 hidden bg-background/60"
        data-collection-loader
      ></div>
      {% paginate collection.products by products_per_page %}
        {%- if collection.products.size > 0 -%}
          <div
            class="grid {{ grid_class_mobile }} {{ grid_class_desktop }} gap-x-3 gap-y-8 md:gap-x-4 md:gap-y-10"
            data-product-grid
          >
            {%- for product in collection.products -%}
              {% render 'product-card',
                card_product: product,
                show_vendor: false,
                lazy_load: false,
                card_class: 'w-full'
              %}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="mt-8">
              {% render 'pagination', paginate: paginate %}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="flex min-h-[300px] flex-col items-center justify-center text-center">
            <p class="mb-4 text-muted">{{ 'collections.no_products' | t }}</p>
            {%- if collection.filters.size > 0 -%}
              <a
                href="{{ collection.url }}"
                class="text-sm underline transition-colors hover:text-foreground"
                data-clear-filters
              >
                {{ 'collections.clear_all' | t }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {% endpaginate %}
    </div>
  </div>
</section>

{%- comment -%} Mobile filter drawer {%- endcomment -%}
{%- if has_filters -%}
  <div
    class="fixed inset-0 z-[70] hidden"
    id="filter-drawer"
    data-filter-drawer
  >
    {%- comment -%} Overlay {%- endcomment -%}
    <div
      class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"
      data-filter-overlay
    ></div>

    {%- comment -%} Panel {%- endcomment -%}
    <div
      class="absolute inset-y-0 left-0 flex w-full max-w-sm -translate-x-full flex-col bg-background shadow-xl transition-transform duration-300"
      data-filter-panel
    >
      <div class="flex items-center justify-between border-b border-border px-4 py-4">
        <h2 class="text-lg font-bold">{{ 'collections.filter' | t }}</h2>
        <button type="button" class="transition-colors hover:text-muted" data-filter-close>
          {% render 'icon-close', size: 20, class: 'w-5 h-5' %}
        </button>
      </div>

      <div class="flex-1 overflow-y-auto px-4 py-4">
        {% render 'collection-filters', collection: collection %}
      </div>

      <div class="border-t border-border px-4 py-4">
        <a
          href="{{ collection.url }}"
          class="mb-2 block w-full rounded border border-border py-2.5 text-center text-sm font-medium transition-colors hover:bg-muted/10"
          data-clear-filters
        >
          {{ 'collections.clear_all' | t }}
        </a>
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} Sort drawer (mobile) {%- endcomment -%}
{% render 'collection-sort-drawer', collection: collection, current_sort: current_sort %}

{%- comment -%} Sticky mobile sort/filter bar {%- endcomment -%}
{%- if has_filters -%}
  <div
    class="fixed bottom-4 left-1/2 z-40 invisible w-[60%] max-w-xs -translate-x-1/2 translate-y-4 rounded-lg bg-black/70 opacity-0 shadow-lg backdrop-blur-lg transition-all duration-300 ease-out lg:hidden"
    data-sticky-bar
    data-default-sort="{{ collection.default_sort_by }}"
  >
    <div class="flex items-stretch justify-between">
      <button
        type="button"
        class="flex flex-1 items-center justify-center gap-2 p-3 text-white"
        data-sort-toggle
        aria-label="{{ 'collections.sort_by' | t }}"
      >
        <span class="relative text-sm font-medium">
          {{ 'collections.sort_by' | t }}
          <span
            class="absolute -right-1.5 -top-0.5 h-1.5 w-1.5 rounded-full bg-accent{% unless is_sort_active %} hidden{% endunless %}"
            data-sort-indicator
          ></span>
        </span>
      </button>

      <div class="w-px bg-white/30"></div>

      <button
        type="button"
        class="flex flex-1 items-center justify-center gap-2 p-3 text-white"
        data-filter-toggle
        aria-expanded="false"
        aria-controls="filter-drawer"
        aria-label="{{ 'collections.filter' | t }}"
      >
        <span class="relative text-sm font-medium">
          {{ 'collections.filter' | t }}
          <span
            class="absolute -right-1.5 -top-0.5 h-1.5 w-1.5 rounded-full bg-accent{% unless has_active_filters %} hidden{% endunless %}"
            data-filter-indicator
          ></span>
        </span>
        {% render 'icon-filter', size: 14 %}
      </button>
    </div>
  </div>
{%- endif -%}

<script src="{{ 'collection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Collection",
  "class": "collection-section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    }
  ]
}
{% endschema %}
