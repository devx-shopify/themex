    "theme_documentation_url": "https://devxcommerce.com",
    "theme_support_url": "https://devxcommerce.com/support"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "cormorant_n4",
        "label": "Primary"
      },
      {
        "type": "font_picker",
        "id": "type_secondary_font",
        "default": "work_sans_n4",
        "label": "Secondary"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
