        "default": "#FFFFFF"
      },
      {
        "type": "header",
        "content": "Color display"
      },
      {
        "type": "select",
        "id": "product_color_display",
        "label": "Color display mode",
        "options": [
          { "value": "hide", "label": "Hide" },
          { "value": "count", "label": "Count" },
          { "value": "swatch", "label": "Swatch" },
          { "value": "variant", "label": "Variant image" }
        ],
        "default": "swatch"
      }
