      {
        "type": "header",
        "content": "Status Colors"
      },
      {
        "type": "color",
        "id": "color_error",
        "label": "Error",
        "default": "#DC2626"
      },
      {
        "type": "color",
        "id": "color_error_wash",
        "label": "Error wash",
        "default": "#FEF2F2",
