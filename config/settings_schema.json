      },
      {
        "type": "color",
        "id": "discount_badge_bg_color",
        "label": "Discount Badge Background",
        "default": "#000"
      },
      {
        "type": "color",
        "id": "discount_badge_text_color",
        "label": "Discount Badge Text",
